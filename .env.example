# Default BambooHR API configuration for stdio mode
BAMBOO_API_TOKEN=your_api_token_here
BAMBOO_COMPANY_DOMAIN=your_company_name

# Transport configuration
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=3000
MCP_HTTP_PATH=/mcp
MCP_HTTP_ENABLE_JSON_RESPONSE=false
BAMBOO_ENABLE_MUTATIONS=false

# Optional HTTP allowlists / hardening
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_ENABLE_DNS_REBINDING_PROTECTION=false

# Optional: Enable debug logging
DEBUG=false
